rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    match /profiles/{u} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == u;
    }
    match /users/{u} {
      allow read, write: if request.auth != null && request.auth.uid == u;
    }
    match /chats/{c}/msgs/{m} {
      allow read: if request.auth != null && request.auth.uid in c.split('_');
      allow create: if request.auth != null
        && request.auth.uid in c.split('_')
        && request.resource.data.from == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 300;
    }
  }
}
